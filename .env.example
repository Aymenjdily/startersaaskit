DATABASE_URL=
DATABASE_URL_POOLER=

# Supabase — this product's own auth (dashboard → Project Settings → API).
# Both are shipped to the browser, so this must be the anon/publishable key.
# Never put the service-role key behind a VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
