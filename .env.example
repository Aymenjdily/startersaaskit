# Supabase — this product's own auth (dashboard → Project Settings → API).
# Both are shipped to the browser, so this must be the anon/publishable key.
# Never put the service-role key behind a VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog — product analytics and session recording. Optional: the app runs
# fine with this unset, analytics just stays off. VITE_POSTHOG_HOST defaults
# to PostHog Cloud's US region if left blank; set it to eu.i.posthog.com (or
# your own instance) otherwise.
VITE_POSTHOG_KEY=phc_DhQihYcGNniLjZ4anUv4qWBeyx6sqtyasG9ompgWg44m
VITE_POSTHOG_HOST=https://us.i.posthog.com
